{
  "name": "dsh-agent-team-prompt-override",
  "version": "0.1.0",
  "description": "Override the DeepSeek Harness Agent Teams policy gate so teammates may be created proactively when parallel work is useful.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "agent-teams",
    "system-prompt",
    "prompt-override",
    "teammates"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Soulize/dsh-agent-teams-prompt-assemble.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.1.7-rc.1"
    }
  }
}
